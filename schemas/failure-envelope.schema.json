{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/failure-envelope.schema.json",
  "title": "Failure Envelope v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "task_id",
    "attempt_id",
    "parent_failure_id",
    "failure_id",
    "failure_class",
    "reason_code",
    "fingerprint",
    "safe_message",
    "expected",
    "actual",
    "failed_gate_ids",
    "evidence_refs",
    "exception_type",
    "stack_fingerprint",
    "retryable",
    "owner_action_eligible"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "task_id": {"type": "string", "minLength": 4},
    "attempt_id": {"type": ["string", "null"]},
    "parent_failure_id": {"type": ["string", "null"]},
    "failure_id": {"type": "string", "minLength": 8},
    "failure_class": {"enum": ["transient", "semantic", "external", "controller", "policy"]},
    "reason_code": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safe_message": {"type": "string", "minLength": 1, "maxLength": 4000},
    "expected": {"type": "object"},
    "actual": {"type": "object"},
    "failed_gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "exception_type": {"type": ["string", "null"]},
    "stack_fingerprint": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "retryable": {"type": "boolean"},
    "owner_action_eligible": {"type": "boolean"}
  }
}
