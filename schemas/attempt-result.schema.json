{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/attempt-result.schema.json",
  "title": "Attempt Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "task_id",
    "attempt_id",
    "tier",
    "attempt_kind",
    "prompt_digest",
    "subject_sha_before",
    "status",
    "summary",
    "changed_files",
    "commands",
    "test_results",
    "assumptions",
    "findings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 8
    },
    "product_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tier"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "deterministic",
            "luna",
            "terra",
            "sol"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "type": "string",
      "enum": [
        "deterministic",
        "luna",
        "terra",
        "sol"
      ]
    },
    "attempt_kind": {
      "type": "string",
      "enum": [
        "initial",
        "repair",
        "transient_retry",
        "arbitration"
      ]
    },
    "prompt_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_sha_before": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "repair_required",
        "needs_replan",
        "blocked_external",
        "failed_safe"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "change"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "result"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "artifact_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "status"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "text"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
