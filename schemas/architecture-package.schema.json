{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/architecture-package.schema.json",
  "title": "Architecture Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "status",
    "summary",
    "components",
    "interfaces",
    "data_stores",
    "trust_boundaries",
    "adrs",
    "deployment",
    "observability",
    "backup_restore",
    "rollback",
    "test_strategy",
    "capacity",
    "assumptions",
    "findings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 8
    },
    "product_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tier"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "deterministic",
            "luna",
            "terra",
            "sol"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "repair_required",
        "needs_replan",
        "blocked_external",
        "failed_safe"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "responsibility",
          "technology",
          "data_owned"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "technology": {
            "type": "string",
            "minLength": 1
          },
          "data_owned": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "protocol",
          "contract"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "data_stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "purpose",
          "classification",
          "retention"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "public",
              "internal",
              "confidential",
              "restricted"
            ]
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trust_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "decision",
          "status",
          "rationale",
          "consequences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-[0-9]{3,}$"
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "superseded",
              "rejected"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging",
        "production",
        "image_promotion",
        "https"
      ],
      "properties": {
        "staging": {
          "type": "string",
          "minLength": 1
        },
        "production": {
          "type": "string",
          "minLength": 1
        },
        "image_promotion": {
          "type": "string",
          "minLength": 1
        },
        "https": {
          "type": "boolean"
        }
      }
    },
    "observability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "backup_restore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup",
        "restore_test"
      ],
      "properties": {
        "backup": {
          "type": "string",
          "minLength": 1
        },
        "restore_test": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "trigger",
        "verification"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fits_current_vps",
        "constraints"
      ],
      "properties": {
        "fits_current_vps": {
          "type": "boolean"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
