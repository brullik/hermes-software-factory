{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/plan-proposal-v1.schema.json",
  "title": "Semantic Plan Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "status",
    "proposal_kind",
    "parent_plan_id",
    "source_failure_id",
    "goals",
    "nodes",
    "summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "tier"],
      "properties": {
        "role": {"enum": ["task-specifier", "replanner"]},
        "tier": {"enum": ["luna", "terra", "sol"]},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]}
      }
    },
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["completed", "needs_replan", "failed_safe"]},
    "proposal_kind": {"enum": ["initial", "replan_delta"]},
    "parent_plan_id": {"type": ["string", "null"]},
    "source_failure_id": {"type": ["string", "null"]},
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal_id", "statement", "mandatory"],
        "properties": {
          "goal_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "statement": {"type": "string", "minLength": 10, "maxLength": 4000},
          "mandatory": {"type": "boolean"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_key",
          "stage_kind",
          "title",
          "objective",
          "depends_on",
          "scope",
          "acceptance_intents",
          "goal_ids"
        ],
        "properties": {
          "node_key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
          },
          "stage_kind": {"const": "implementation_slice"},
          "title": {"type": "string", "minLength": 5, "maxLength": 240},
          "objective": {"type": "string", "minLength": 10, "maxLength": 4000},
          "depends_on": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
            "uniqueItems": true
          },
          "scope": {
            "description": "Bounded repository write scope expressed only as relative POSIX path globs, for example src/**, tests/**, or README.md. Prose is invalid.",
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*\\s)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
            },
            "uniqueItems": true
          },
          "acceptance_intents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {"type": "string", "minLength": 10, "maxLength": 2000},
            "uniqueItems": true
          },
          "goal_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1, "maxLength": 120},
            "uniqueItems": true
          }
        }
      }
    },
    "summary": {"type": "string", "minLength": 20, "maxLength": 4000},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
