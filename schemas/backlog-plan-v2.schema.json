{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/backlog-plan-v2.schema.json",
  "title": "Executable Backlog Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "status",
    "plan_id",
    "revision",
    "parent_plan_id",
    "source_failure_id",
    "goals",
    "nodes",
    "edges",
    "completion_criteria",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"type": "object"},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["completed", "needs_replan", "failed_safe"]},
    "plan_id": {"type": "string", "minLength": 4},
    "revision": {"type": "integer", "minimum": 1},
    "parent_plan_id": {"type": ["string", "null"]},
    "source_failure_id": {"type": ["string", "null"]},
    "goals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["goal_id", "statement", "mandatory", "acceptance_ids"],
        "properties": {
          "goal_id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "acceptance_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "mandatory", "task_contract"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "mandatory": {"type": "boolean"},
          "task_contract": {"$ref": "task-contract-v2.schema.json"},
          "task_contract_ref": {"type": "string"},
          "task_contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "edge_type", "required"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "edge_type": {"enum": ["depends_on", "evidence_from", "supersedes", "repair_of", "replan_of"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "completion_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 1},
    "compiler_version": {"type": "string", "minLength": 1},
    "lifecycle_version": {"type": "string", "minLength": 1},
    "proposal_artifact_ref": {"type": "string", "minLength": 1},
    "proposal_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
