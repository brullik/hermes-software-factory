{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/pilot-black-box.schema.json",
  "title": "Pilot Black Box Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "status",
    "endpoint",
    "checks",
    "restart_persistence",
    "rollback",
    "summary",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "tier"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "tier": {"type": "string", "enum": ["deterministic", "luna", "terra", "sol"]},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]}
      }
    },
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "endpoint": {"type": "string", "format": "uri"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["PASS", "FAIL"]},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "restart_persistence": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"]},
    "rollback": {"type": "string", "enum": ["PASS", "FAIL", "NOT_TESTED_EXTERNAL"]},
    "summary": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
