{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/completion-evidence.schema.json",
  "title": "Product Completion Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "plan_id",
    "completed_at",
    "goal_evidence",
    "node_evidence",
    "release_digest",
    "observation_ref"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "plan_id": {"type": "string", "minLength": 4},
    "completed_at": {"type": "string", "format": "date-time"},
    "goal_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "node_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "release_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation_ref": {"type": "string", "minLength": 1}
  }
}
