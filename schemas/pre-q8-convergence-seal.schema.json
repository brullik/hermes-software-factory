{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes.local/schemas/pre-q8-convergence-seal.schema.json",
  "title": "Hermes PRE-Q8 Convergence Seal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seal_type",
    "status",
    "run_id",
    "source_commit",
    "git_tree",
    "release_tree_digest",
    "requirements_lock_digest",
    "toolchain_digest",
    "systemd_bundle_digest",
    "catalog_digest",
    "ordered_scenarios",
    "base_config_digest",
    "generated_config_digests",
    "capability_attestation_digest",
    "fixture_seed_digest",
    "evidence_digests",
    "matrix_digest",
    "verifier_public_key_digest",
    "seal_digest",
    "verifier_signature",
    "signed_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "seal_type": {"const": "PREQ8_CONVERGENCE_SEAL"},
    "status": {"const": "10/10 PASS"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "source_commit": {"$ref": "#/$defs/sha1"},
    "git_tree": {"$ref": "#/$defs/sha1"},
    "release_tree_digest": {"$ref": "#/$defs/sha256"},
    "requirements_lock_digest": {"$ref": "#/$defs/sha256"},
    "toolchain_digest": {"$ref": "#/$defs/sha256"},
    "systemd_bundle_digest": {"$ref": "#/$defs/sha256"},
    "catalog_digest": {"$ref": "#/$defs/sha256"},
    "ordered_scenarios": {"$ref": "#/$defs/ordered_scenarios"},
    "base_config_digest": {"$ref": "#/$defs/sha256"},
    "generated_config_digests": {"$ref": "#/$defs/scenario_digests"},
    "capability_attestation_digest": {"$ref": "#/$defs/sha256"},
    "fixture_seed_digest": {"$ref": "#/$defs/sha256"},
    "evidence_digests": {"$ref": "#/$defs/scenario_digests"},
    "matrix_digest": {"$ref": "#/$defs/sha256"},
    "verifier_public_key_digest": {"$ref": "#/$defs/sha256"},
    "seal_digest": {"$ref": "#/$defs/sha256"},
    "verifier_signature": {"type": "string", "minLength": 88, "maxLength": 88},
    "signed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ordered_scenarios": {
      "type": "array",
      "prefixItems": [
        {"const": "zero-dependency-cli"},
        {"const": "small-python-service"},
        {"const": "telegram-bot"},
        {"const": "existing-repository-repair"},
        {"const": "high-fan-in"},
        {"const": "external-blocker-resume"},
        {"const": "provider-timeout-restart"},
        {"const": "failed-product-test-one-repair"},
        {"const": "package-only"},
        {"const": "deploy-rollback"}
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    },
    "scenario_digests": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "zero-dependency-cli",
          "small-python-service",
          "telegram-bot",
          "existing-repository-repair",
          "high-fan-in",
          "external-blocker-resume",
          "provider-timeout-restart",
          "failed-product-test-one-repair",
          "package-only",
          "deploy-rollback"
        ]
      },
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  }
}
