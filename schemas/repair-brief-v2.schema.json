{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/repair-brief-v2.schema.json",
  "title": "Repair Brief v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "task_id",
    "root_task_id",
    "failed_task_id",
    "failure_id",
    "hypothesis_id",
    "parent_hypothesis_id",
    "plan_id",
    "plan_node_id",
    "inherited_goal_ref",
    "inherited_acceptance",
    "failed_gate_ids",
    "required_fixes",
    "evidence_refs",
    "allowed_paths",
    "capability_gaps",
    "supersedes_task_id",
    "definition_of_done"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_id": {"type": "string", "minLength": 8},
    "product_id": {"type": "string", "minLength": 8},
    "task_id": {"type": "string", "minLength": 4},
    "root_task_id": {"type": "string", "minLength": 4},
    "failed_task_id": {"type": "string", "minLength": 4},
    "failure_id": {"type": "string", "minLength": 8},
    "hypothesis_id": {"type": "string", "minLength": 8},
    "parent_hypothesis_id": {"type": ["string", "null"]},
    "plan_id": {"type": "string", "minLength": 4},
    "plan_node_id": {"type": "string", "minLength": 1},
    "inherited_goal_ref": {"type": "string", "minLength": 1},
    "inherited_acceptance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "failed_gate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_fixes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "capability_gaps": {"type": "array", "items": {"type": "string"}},
    "supersedes_task_id": {"type": ["string", "null"]},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
