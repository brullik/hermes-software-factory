{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Candidate Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "product_id",
    "plan_id",
    "repository_commit",
    "tree_digest",
    "architecture_binding_id",
    "result_binding_ids",
    "snapshot_digest",
    "created_at",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^CS-[A-Z0-9_-]{8,}$"},
    "product_id": {"type": "string", "minLength": 8},
    "plan_id": {"type": "string", "minLength": 4},
    "repository_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "architecture_binding_id": {
      "type": "string",
      "pattern": "^RB-[A-Z0-9_-]{8,}$"
    },
    "result_binding_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^RB-[A-Z0-9_-]{8,}$"}
    },
    "snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["FROZEN", "SUPERSEDED", "RELEASED"]}
  }
}
