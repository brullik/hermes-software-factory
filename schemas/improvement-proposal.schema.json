{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "improvement-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "objective_id", "root_cause_key", "baseline_digest", "observed_deficit", "proposal", "affected_components", "expected_delta", "non_regression_obligations", "risk_class", "budget", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "objective_id": {"type": "string"},
    "root_cause_key": {"type": "string"},
    "baseline_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observed_deficit": {"type": "object"},
    "proposal": {"type": "object"},
    "affected_components": {"type": "array", "items": {"type": "string"}},
    "expected_delta": {"type": "object", "minProperties": 1},
    "non_regression_obligations": {"type": "array", "minItems": 1},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "budget": {"type": "object", "required": ["max_cycles", "max_implementation_attempts"], "properties": {"max_cycles": {"type": "integer", "minimum": 1, "maximum": 3}, "max_implementation_attempts": {"type": "integer", "minimum": 1, "maximum": 2}}},
    "evidence_refs": {"type": "array", "minItems": 1}
  }
}
