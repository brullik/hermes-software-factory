{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Path Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "product_id",
    "active_plan_id",
    "active_revision",
    "mandatory_obligations",
    "frontier",
    "open_problems",
    "progress_vector",
    "snapshot_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string"},
    "product_id": {"type": "string"},
    "active_plan_id": {"type": "string"},
    "active_revision": {"type": "integer", "minimum": 0},
    "candidate_snapshot_id": {"type": ["string", "null"]},
    "mandatory_obligations": {"type": "array", "items": {"type": "object"}},
    "frontier": {"type": "array", "items": {"type": "object"}},
    "open_problems": {"type": "array", "items": {"type": "object"}},
    "progress_vector": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "snapshot_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
