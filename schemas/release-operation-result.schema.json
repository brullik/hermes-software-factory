{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brullik.github.io/hermes-software-factory/schemas/release-operation-result.schema.json",
  "title": "Release Operation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "product_id",
    "created_at",
    "producer",
    "policy_digest",
    "status",
    "repository",
    "candidate_sha",
    "merge",
    "release",
    "staging",
    "production",
    "rollback",
    "summary",
    "findings",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 8
    },
    "product_id": {
      "type": "string",
      "minLength": 8
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tier"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "deterministic",
            "luna",
            "terra",
            "sol"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "repair_required",
        "needs_replan",
        "blocked_external",
        "failed_safe"
      ]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "merge_sha"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "merge_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image_digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "image_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "staging": {
      "type": "string",
      "enum": [
        "deployed",
        "failed",
        "not_started"
      ]
    },
    "production": {
      "type": "string",
      "enum": [
        "deployed",
        "rolled_back",
        "blocked_policy",
        "not_started"
      ]
    },
    "rollback": {
      "type": "string",
      "enum": [
        "not_needed",
        "succeeded",
        "failed",
        "not_tested"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
