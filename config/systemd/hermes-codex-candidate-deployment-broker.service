[Unit]
Description=Hermes Codex typed immutable Candidate deployment broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/hermes-codex-runtime/current
Environment=HOME=/root
Environment=PYTHONPATH=/opt/hermes-codex-runtime/current
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=GIT_TERMINAL_PROMPT=0
StateDirectory=hermes-codex-candidate-deployment
StateDirectoryMode=0700
RuntimeDirectory=hermes-codex-candidate-deployment-broker
RuntimeDirectoryMode=0755
ExecStart=/opt/hermes-codex-runtime/current/.venv/bin/python -m scripts.codex_candidate_deployment_broker
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillMode=control-group
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/hermes-codex-candidate-deployment
ReadWritePaths=/run/hermes-codex-candidate-deployment-broker
ReadWritePaths=/etc/hermes-factory
ReadWritePaths=/etc/systemd/system
ReadWritePaths=/opt/hermes-factory-candidate
ReadWritePaths=/opt/hermes-factory-verifier
ReadWritePaths=/usr/libexec/hermes-github-askpass
ReadWritePaths=/usr/local/sbin/hermes-qualified-release-submit
ReadWritePaths=/var/lib/hermes-factory-candidate
ReadWritePaths=/var/lib/hermes-factory-verifier
ReadWritePaths=/var/lib/hermes-factory-canaries
ReadWritePaths=/var/lib/hermes-factory-functional
ReadWritePaths=/var/lib/hermes-factory-github-broker
ReadWritePaths=/var/lib/hermes-factory-pre-q8
ReadWritePaths=/var/lib/hermes-factory-improvement-lab
ReadWritePaths=/var/lib/hermes-factory-golden
ReadWritePaths=/var/lib/hermes-factory-shadow-output
ReadWritePaths=/var/lib/hermes-factory-shadow-feed
ReadWritePaths=/var/lib/hermes-factory-qualification-backup
ReadWritePaths=/var/log/hermes-factory-candidate
ReadWritePaths=/var/log/hermes-factory-canaries
ReadWritePaths=/var/log/hermes-factory-pre-q8
ReadWritePaths=/var/log/hermes-factory-golden
ReadWritePaths=/run/systemd
ReadWritePaths=/run/hermes-factory-candidate
ReadWritePaths=/etc/.pwd.lock
ReadWritePaths=/etc/passwd /etc/shadow /etc/group /etc/gshadow /etc/subuid /etc/subgid
ReadOnlyPaths=/opt/hermes-codex-runtime
ReadOnlyPaths=/opt/hermes-factory
ReadOnlyPaths=/var/lib/hermes-factory
ReadOnlyPaths=/var/lib/hermes-codex-github-broker/receipts
InaccessiblePaths=/etc/hermes-factory/credentials.d
InaccessiblePaths=/home/hermescodex/.codex
InaccessiblePaths=/var/lib/hermes-codex-owner-actions
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
