[Unit]
Description=Checkpoint exact Hermes Q0-Q6 epoch for functional qualification
After=network-online.target
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml

[Service]
Type=oneshot
User=hermesverifier
Group=hermesverifier
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.qualification_control functional-handoff
Environment=HOME=/var/lib/hermes-factory-verifier
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /etc/hermes-factory/qualification-control.yaml
ReadWritePaths=/var/lib/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory/controller.db -/var/lib/hermes-factory-candidate/controller.db /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
TasksMax=64
TimeoutStartSec=120
