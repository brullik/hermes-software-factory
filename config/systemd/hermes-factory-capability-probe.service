[Unit]
Description=Hermes real operation-specific Q6.5 capability probe
After=network-online.target hermes-factory-github-broker.service
Requires=hermes-factory-github-broker.service

[Service]
Type=oneshot
User=hermescandidate
Group=hermesfunctional
SupplementaryGroups=hermescandidate
WorkingDirectory=/opt/hermes-factory-candidate/current
Environment=HOME=/var/lib/hermes-factory-candidate
Environment=XDG_RUNTIME_DIR=/run/hermes-factory-candidate
ExecStart=/opt/hermes-factory-candidate/venv/bin/python -m scripts.q6_5_live --credential-epoch-file /var/lib/hermes-factory-functional/credential-epoch
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-functional /var/lib/hermes-factory-candidate /run/hermes-factory-candidate
ReadOnlyPaths=/opt/hermes-factory-candidate /etc/hermes-factory/qualification-control.yaml /etc/hermes-factory/candidate.yaml /etc/hermes-factory/candidate-model-registry.yaml /run/hermes-factory-github-broker/broker.sock
InaccessiblePaths=/var/lib/hermes-factory /var/lib/hermes-factory-verifier /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=3000M
TasksMax=512
