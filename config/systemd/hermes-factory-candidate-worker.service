[Unit]
Description=Hermes Software Factory Candidate B worker
After=network-online.target hermes-factory-candidate-controller.service hermes-factory-github-broker.service
Wants=network-online.target
Requires=hermes-factory-candidate-controller.service hermes-factory-github-broker.service

[Service]
Type=simple
User=hermescandidate
Group=hermescandidate
WorkingDirectory=/opt/hermes-factory-candidate/current
Environment=FACTORY_CONFIG=/etc/hermes-factory/candidate.yaml
Environment=HOME=/var/lib/hermes-factory-candidate
Environment=XDG_RUNTIME_DIR=/run/hermes-factory-candidate
Environment=HERMES_GITHUB_BROKER_SOCKET=/run/hermes-factory-github-broker/broker.sock
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/hermes-factory-candidate/venv/bin/python -m factory.worker --worker-id candidate-worker-1
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-candidate /var/log/hermes-factory-candidate /run/hermes-factory-candidate
ReadOnlyPaths=/etc/hermes-factory/candidate.yaml /etc/hermes-factory/candidate-model-registry.yaml /run/hermes-factory-github-broker/broker.sock
InaccessiblePaths=/var/lib/hermes-factory /var/lib/hermes-factory-verifier /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /etc/hermes-factory/verifier.yaml /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2400M
TasksMax=512
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
