[Unit]
Description=Run and independently verify the Hermes Golden Product
After=network-online.target hermes-factory-github-broker.service
Requires=hermes-factory-github-broker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/current/scripts/qualification/run-golden-product.sh
TimeoutStartSec=72h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-golden /var/lib/hermes-factory-functional /var/lib/hermes-factory-candidate /run/systemd
ReadOnlyPaths=/etc/hermes-factory /opt/hermes-factory-candidate /opt/hermes-factory-verifier /var/lib/hermes-factory/controller.db
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
LockPersonality=true
