[Unit]
Description=Hermes durable Candidate capability reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/current/scripts/qualification/reconcile-functional.sh
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-functional /run/systemd
ReadOnlyPaths=/opt/hermes-factory-verifier /opt/hermes-factory-candidate /etc/hermes-factory/qualification-control.yaml /etc/hermes-factory/candidate-credentials.d
InaccessiblePaths=/var/lib/hermes-factory/controller.db /etc/hermes-factory/credentials.d
RestrictSUIDSGID=true
LockPersonality=true
