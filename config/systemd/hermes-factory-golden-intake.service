[Unit]
Description=Receive exact Hermes Golden Product intake from Telegram owner
After=network-online.target hermes-factory-golden-controller.service
Requires=hermes-factory-golden-controller.service

[Service]
Type=oneshot
User=hermescandidate
Group=hermesfunctional
WorkingDirectory=/opt/hermes-factory-candidate/current
Environment=HOME=/var/lib/hermes-factory-candidate
LoadCredential=candidate-telegram-token:/etc/hermes-factory/candidate-credentials.d/candidate-telegram-token
ExecStart=/opt/hermes-factory-candidate/venv/bin/python -m scripts.golden_intake
TimeoutStartSec=24h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-golden /var/lib/hermes-factory-functional
ReadOnlyPaths=/etc/hermes-factory/golden.yaml
InaccessiblePaths=/var/lib/hermes-factory /var/lib/hermes-factory-verifier /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
