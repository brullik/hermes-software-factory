[Unit]
Description=Hermes all-ten PRE-Q8 convergence sweep (%i)
After=network-online.target hermes-factory-github-broker.service
Requires=hermes-factory-github-broker.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=hermesverifier hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/current/scripts/qualification/run-pre-q8-convergence.sh %i
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/hermes-factory/pre-q8-convergence /var/lib/hermes-factory-pre-q8-convergence /var/log/hermes-factory-pre-q8-convergence /var/lib/hermes-factory-candidate /run/systemd
ReadOnlyPaths=/etc/hermes-factory/qualification-control.yaml /etc/hermes-factory/candidate.yaml /etc/hermes-factory/candidate-credentials.d/github-token /opt/hermes-factory-candidate /opt/hermes-factory-verifier /var/lib/hermes-factory-verifier/verifier-ed25519.key
InaccessiblePaths=/var/lib/hermes-factory /var/lib/hermes-factory-pre-q8 /etc/hermes-factory/credentials.d
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
LockPersonality=true
