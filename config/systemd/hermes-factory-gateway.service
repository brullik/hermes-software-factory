[Unit]
Description=Hermes Software Factory Telegram Gateway
After=network-online.target hermes-factory-controller.service
Wants=network-online.target

[Service]
Type=simple
User=hermesfactory
Group=hermesfactory
WorkingDirectory=/opt/hermes-factory/current
Environment=FACTORY_CONFIG=/etc/hermes-factory/config.yaml
EnvironmentFile=-/etc/hermes-factory/telegram.env
LoadCredential=telegram-token:/etc/hermes-factory/credentials.d/telegram-token
ExecStart=/opt/hermes-factory/venv/bin/python -m factory.gateway
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory /var/log/hermes-factory /run/hermes-factory
ReadOnlyPaths=/etc/hermes-factory
RestrictSUIDSGID=true
MemoryMax=500M
TasksMax=256

[Install]
WantedBy=multi-user.target
