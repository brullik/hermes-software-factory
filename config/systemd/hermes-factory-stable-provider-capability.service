[Unit]
Description=Prove permanent Hermes Stable provider routes
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml
OnSuccess=hermes-factory-functional-qualification.service

[Service]
Type=oneshot
User=hermesfactory
Group=hermesfactory
SupplementaryGroups=hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
Environment=HOME=/var/lib/hermes-factory
Environment=XDG_RUNTIME_DIR=/run/hermes-factory
Environment=TERMINAL_ENV=docker
Environment=HERMES_DOCKER_BINARY=/usr/bin/podman
Environment=TERMINAL_DOCKER_FORWARD_ENV=[]
Environment=TERMINAL_DOCKER_MOUNT_CWD_TO_WORKSPACE=true
Environment=TERMINAL_DOCKER_PERSIST_ACROSS_PROCESSES=false
Environment=TERMINAL_DOCKER_RUN_AS_HOST_USER=true
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.stable_provider_capability
TimeoutStartSec=1h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/hermes-factory/config.yaml /etc/hermes-factory/model-registry.yaml /etc/hermes-factory/qualification-control.yaml /opt/hermes-factory-verifier
ReadWritePaths=/var/lib/hermes-factory /var/lib/hermes-factory-functional /run/hermes-factory
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /var/lib/hermes-factory/controller.db
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1200M
TasksMax=256
