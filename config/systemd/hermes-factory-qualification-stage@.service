[Unit]
Description=Hermes independent qualification stage %i
After=network-online.target
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml

[Service]
Type=oneshot
User=hermesverifier
Group=hermesverifier
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.qualification_control stage %i
Environment=HOME=/var/lib/hermes-factory-verifier
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /opt/hermes-factory-candidate /etc/hermes-factory/qualification-control.yaml
ReadWritePaths=/var/lib/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory/controller.db /var/lib/hermes-factory-candidate/controller.db /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=3000M
TasksMax=1024
TimeoutStartSec=1800
