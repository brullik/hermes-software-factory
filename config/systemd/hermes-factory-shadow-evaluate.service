[Unit]
Description=Evaluate Stable A feed through isolated Candidate B catalogs
Requires=hermes-factory-shadow-export.service
After=hermes-factory-shadow-export.service
OnFailure=hermes-factory-shadow-fail@evaluate.service

[Service]
Type=oneshot
User=hermescandidate
Group=hermescandidate
SupplementaryGroups=hermesshadow
WorkingDirectory=/opt/hermes-factory-candidate/current
ExecStart=/opt/hermes-factory-candidate/venv/bin/python -m scripts.shadow_feed evaluate --feed-root /var/lib/hermes-factory-shadow-feed --output-root /var/lib/hermes-factory-shadow-output/@SOURCE_COMMIT@
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-candidate /var/lib/hermes-factory-shadow-feed
ReadWritePaths=/var/lib/hermes-factory-shadow-output/@SOURCE_COMMIT@
InaccessiblePaths=/var/lib/hermes-factory/controller.db /var/lib/hermes-factory-verifier /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
MemoryMax=512M
TasksMax=128
