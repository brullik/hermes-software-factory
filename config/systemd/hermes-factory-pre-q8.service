[Unit]
Description=Run exact ten Hermes PRE-Q8 first-run scenarios
After=network-online.target hermes-factory-github-broker.service
Requires=hermes-factory-github-broker.service

[Service]
Type=oneshot
LoadCredential=github-token:/etc/hermes-factory/candidate-credentials.d/github-token
User=root
Group=root
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/current/scripts/qualification/run-all-pre-q8.sh
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-pre-q8 /var/log/hermes-factory-pre-q8 /var/lib/hermes-factory-functional /var/lib/hermes-factory-candidate /run/systemd
ReadOnlyPaths=/etc/hermes-factory/pre-q8 /etc/hermes-factory/qualification-control.yaml /opt/hermes-factory-candidate /opt/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
LockPersonality=true
