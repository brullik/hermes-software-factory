[Unit]
Description=Attest permanent Stable internal state without mutation
After=hermes-factory-controller.service
Requires=hermes-factory-controller.service
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml

[Service]
Type=oneshot
User=hermesfactory
Group=hermesfactory
SupplementaryGroups=hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.stable_runtime_attestation
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /etc/hermes-factory/qualification-control.yaml /var/lib/hermes-factory/controller.db
ReadWritePaths=/var/lib/hermes-factory-functional
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=64
TimeoutStartSec=5min
