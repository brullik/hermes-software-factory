[Unit]
Description=Prove permanent Hermes product GitHub broker operations
After=network-online.target hermes-factory-product-github-broker.service
Wants=hermes-factory-product-github-broker.service
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml
OnSuccess=hermes-factory-functional-qualification.service

[Service]
Type=oneshot
User=hermesfactory
Group=hermesfactory
SupplementaryGroups=hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
Environment=HOME=/var/lib/hermes-factory
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.product_github_capability
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/hermes-factory/qualification-control.yaml /opt/hermes-factory-verifier -/run/hermes-factory-product-github-broker/broker.sock
ReadWritePaths=/var/lib/hermes-factory/worktrees /var/lib/hermes-factory-functional
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /var/lib/hermes-factory/controller.db /var/lib/hermes-factory-verifier
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=512M
TasksMax=128
TimeoutStartSec=30min
