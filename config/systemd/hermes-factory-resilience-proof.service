[Unit]
Description=Prove Hermes SQLite backup/restore and isolated blue/green rollback
After=network-online.target
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml
ConditionPathExists=/etc/hermes-factory/qualification-backup-password

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.qualification_resilience
Environment=HOME=/var/lib/hermes-factory-verifier
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /opt/hermes-factory-candidate /opt/hermes-factory/current /var/lib/hermes-factory/controller.db /etc/hermes-factory/qualification-control.yaml /etc/hermes-factory/qualification-backup-password
ReadWritePaths=/var/lib/hermes-factory-verifier /var/lib/hermes-factory-qualification-backup
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1500M
TasksMax=256
