[Unit]
Description=Admit the independently signed Hermes qualification manifest
Requires=hermes-factory-independent-verifier.service
After=hermes-factory-independent-verifier.service

[Service]
Type=oneshot
User=hermesverifier
Group=hermesverifier
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.qualification_control manifest-admit
Environment=HOME=/var/lib/hermes-factory-verifier
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /etc/hermes-factory/qualification-control.yaml /var/lib/hermes-factory-verifier/signed-manifest.json
ReadWritePaths=/var/lib/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory/controller.db /var/lib/hermes-factory-candidate /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=256M
TasksMax=64
