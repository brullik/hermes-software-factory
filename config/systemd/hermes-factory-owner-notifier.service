[Unit]
Description=Hermes typed owner notification delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermesfactory
Group=hermesfactory
SupplementaryGroups=hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
Environment=FACTORY_CONFIG=/etc/hermes-factory/config.yaml
EnvironmentFile=/etc/hermes-factory/telegram.env
LoadCredential=telegram-token:/etc/hermes-factory/credentials.d/telegram-token
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.owner_notifier
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-functional
ReadOnlyPaths=/etc/hermes-factory/config.yaml /etc/hermes-factory/telegram.env /var/lib/hermes-factory-verifier /opt/hermes-factory-verifier
InaccessiblePaths=/etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
