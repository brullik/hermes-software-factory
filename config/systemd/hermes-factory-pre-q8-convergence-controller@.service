[Unit]
Description=Hermes PRE-Q8 convergence controller (%i)
After=network-online.target hermes-factory-github-broker.service
Wants=network-online.target
Requires=hermes-factory-github-broker.service

[Service]
Type=simple
User=hermescandidate
Group=hermescandidate
UMask=0007
WorkingDirectory=/opt/hermes-factory-candidate/current
Environment=HOME=/var/lib/hermes-factory-candidate
Environment=XDG_RUNTIME_DIR=/run/hermes-factory-pre-q8-convergence-%i
Environment=HERMES_GITHUB_BROKER_SOCKET=/run/hermes-factory-github-broker/broker.sock
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=hermes-factory-pre-q8-convergence-%i
RuntimeDirectoryMode=0750
ExecStart=/opt/hermes-factory-candidate/venv/bin/python -m scripts.pre_q8_runtime unit-exec controller %i
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-factory-pre-q8-convergence /var/log/hermes-factory-pre-q8-convergence /var/lib/hermes-factory-candidate /run/hermes-factory-pre-q8-convergence-%i
ReadOnlyPaths=/etc/hermes-factory/pre-q8-convergence /etc/hermes-factory/candidate-model-registry.yaml /run/hermes-factory-github-broker/broker.sock
InaccessiblePaths=/var/lib/hermes-factory /var/lib/hermes-factory-pre-q8 /var/lib/hermes-factory-verifier /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=1200M
TasksMax=256
