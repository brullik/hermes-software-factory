[Unit]
Description=Independently compare Stable A and Candidate B shadow decisions
Requires=hermes-factory-shadow-evaluate.service
After=hermes-factory-shadow-evaluate.service
OnFailure=hermes-factory-shadow-fail@verify.service

[Service]
Type=oneshot
User=hermesverifier
Group=hermesverifier
SupplementaryGroups=hermesshadow
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.qualification_control shadow-verify
Environment=HOME=/var/lib/hermes-factory-verifier
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /opt/hermes-factory-candidate /opt/hermes-factory/current /var/lib/hermes-factory-shadow-feed /var/lib/hermes-factory-shadow-output -/var/lib/hermes-factory-candidate/controller.db /etc/hermes-factory/qualification-control.yaml
ReadWritePaths=/var/lib/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory/controller.db /etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d /usr/local/sbin/hermes-factory-release-submit
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027
MemoryMax=1200M
TasksMax=256
