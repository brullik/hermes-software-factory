[Unit]
Description=Admit and run one sealed official Hermes PRE-Q8 Candidate
After=network-online.target hermes-factory-github-broker.service
Requires=hermes-factory-github-broker.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=hermesverifier hermesfunctional
WorkingDirectory=/opt/hermes-factory-verifier/current
Environment=PRE_Q8_CONVERGENCE_SEAL=/var/lib/hermes-factory-convergence/admitted/seal.json
ExecStart=/opt/hermes-factory-verifier/current/scripts/qualification/run-all-pre-q8.sh ${PRE_Q8_CONVERGENCE_SEAL}
TimeoutStartSec=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/hermes-factory/pre-q8 /var/lib/hermes-factory-pre-q8 /var/log/hermes-factory-pre-q8 /var/lib/hermes-factory-functional /var/lib/hermes-factory-convergence /var/lib/hermes-factory-candidate /run/systemd
ReadOnlyPaths=/etc/hermes-factory/qualification-control.yaml /etc/hermes-factory/candidate.yaml /etc/hermes-factory/canary-capability-attestation.json /etc/hermes-factory/candidate-credentials.d/github-token /opt/hermes-factory-candidate /opt/hermes-factory-verifier /var/lib/hermes-factory-verifier
InaccessiblePaths=/var/lib/hermes-factory /etc/hermes-factory/credentials.d
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
RestrictSUIDSGID=true
LockPersonality=true
