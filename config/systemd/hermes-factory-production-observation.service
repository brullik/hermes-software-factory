[Unit]
Description=Observe promoted Hermes release and rollback on the first invariant failure
After=network-online.target hermes-factory-controller.service
Wants=network-online.target
ConditionPathExists=/etc/hermes-factory/qualification-control.yaml

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/hermes-factory-verifier/current
ExecStart=/opt/hermes-factory-verifier/venv/bin/python -m scripts.production_observation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/hermes-factory-verifier /opt/hermes-factory-candidate /etc/hermes-factory /var/lib/hermes-factory/controller.db
ReadWritePaths=/opt/hermes-factory /var/lib/hermes-factory/evidence /var/lib/hermes-factory-verifier /etc/systemd/system /run/systemd
InaccessiblePaths=/etc/hermes-factory/credentials.d /etc/hermes-factory/candidate-credentials.d
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=800M
TasksMax=256
TimeoutStartSec=300

